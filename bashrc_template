pid() {
    local result; result=$(fuser "${1}/tcp" 2>/dev/null)
    [ -n "$result" ] && echo "🔍 Port $1 → PID: $result" || echo "❌ Nothing is running on port $1"
}

killport() {
    [ -z "$1" ] && { echo -e "\e[1;31m❌ Specify a port (e.g., killport 3000)\e[0m"; return 1; }
    local pid; pid=$(lsof -t -i:"$1" 2>/dev/null)
    [ -z "$pid" ] && { echo -e "\e[1;33m⚠️  No process on port $1.\e[0m"; return 1; }
    local proc_name; proc_name=$(ps -p "$pid" -o comm= 2>/dev/null)
    echo -e "\e[1;36m🔍 '\e[1;32m$proc_name\e[1;36m' (PID: $pid) is on port $1.\e[0m"
    read -r -p $'\e[1;35m❯ Kill it? [y/N]: \e[0m' answer
    [[ "$answer" =~ ^[Yy]$ ]] && kill -9 "$pid" && echo -e "\e[1;32m✅ Killed.\e[0m" || echo -e "\e[1;31m✖ Cancelled.\e[0m"
}

countdown() {
    local total="${1:-10}" i
    for (( i=total; i>=0; i-- )); do
        local pct=$(( i * 100 / total ))
        local color; (( pct > 50 )) && color="\e[1;32m" || { (( pct > 25 )) && color="\e[1;33m" || color="\e[1;31m"; }
        local filled=$(( (total - i) * 20 / total )) empty=$(( 20 - filled ))
        local bar; bar=$(printf '%.0s█' $(seq 1 $filled) 2>/dev/null); bar+=$(printf '%.0s░' $(seq 1 $empty) 2>/dev/null)
        printf "\r${color}⏱  [${bar}] %3ds remaining\e[0m" "$i"; sleep 1
    done
    printf "\r\e[1;32m✅  Done!%-30s\e[0m\n" " "; printf "\a"
}

unalias scan 2>/dev/null
scan() {
    ! command -v nmap &>/dev/null && { echo -e "\e[1;31m❌ nmap not installed.\e[0m"; return 1; }
    local route_info; route_info=$(ip route get 8.8.8.8 2>/dev/null)
    [ -z "$route_info" ] && { echo -e "\e[1;31m❌ No active routing interface.\e[0m"; return 1; }
    local interface; interface=$(echo "$route_info" | awk '{print $5}')
    local subnet; subnet=$(ip addr show "$interface" | grep -w inet | awk '{print $2}')
    echo -e "\e[1;36m🔍 Scanning $subnet on $interface...\e[0m"
    nmap -sP "$subnet"
}
