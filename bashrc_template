# Detect context: SSH, Docker, VM, root
_DETECT_ENVIRONMENT() {
    local env_icon="" env_name="LOCAL"
    if [[ $EUID -eq 0 ]]; then
        env_icon="🔒"; env_name="ROOT"
    elif [ -n "$SSH_CONNECTION" ] || [ -n "$SSH_CLIENT" ]; then
        env_icon="📡"; env_name="SSH"
    elif [ -f /.dockerenv ]; then
        env_icon="🐳"; env_name="DOCKER"
    elif grep -qi "VirtualBox\|VMware\|KVM\|Hyper-V\|QEMU" /sys/class/dmi/id/sys_vendor 2>/dev/null; then
        env_icon="💾"; env_name="VM"
    fi
    echo -ne "${env_icon}:${env_name}"
}

_GET_ENV_COLOR() {
    if [[ $EUID -eq 0 ]]; then
        echo -ne "\e[1;31m"
    elif [ -n "$SSH_CONNECTION" ] || [ -n "$SSH_CLIENT" ]; then
        echo -ne "\e[38;5;51m"
    elif [ -f /.dockerenv ]; then
        echo -ne "\e[38;5;33m"
    elif grep -qi "VirtualBox\|VMware\|KVM\|Hyper-V\|QEMU" /sys/class/dmi/id/sys_vendor 2>/dev/null; then
        echo -ne "\e[38;5;208m"
    else
        echo -ne "\e[38;5;213m"
    fi
}

if [ "$color_prompt" = yes ]; then
    PS1='$(EXIT=$?; if [ $EXIT -eq 0 ]; then echo "\[\e[1;32m\]● "; else echo "\[\e[1;31m\]● "; fi)\[$(_GET_ENV_COLOR)\]\u\[\e[0m\] \[\e[38;5;81m\]\w\[\e[38;5;214m\]$(__git_ps1 " (%s)")\[\e[38;5;245m\] [$(_DETECT_ENVIRONMENT)]\[\e[0m\]\n\[$(_GET_ENV_COLOR)\]❯\[\e[38;5;81m\]❯\[\e[38;5;214m\]❯\[\e[0m\] '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
