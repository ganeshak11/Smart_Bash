# mkdir: auto-cd into the created directory
mkdir() {
    command mkdir -p "$@" && builtin cd "${@: -1}" && echo "📁 Created and entered: $(pwd)"
}
mkcd() { mkdir "$1"; }

# cdf: Interactive dir picker
cdf() {
    local dirs=(*)
    select dir in "${dirs[@]}"; do
        [ -n "$dir" ] && builtin cd "$dir"; break
    done
}

# y: Yazi file manager with cwd support
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

# ld: Numbered directory list with lsd icons
# Usage: ld         → list with numbers
#        ld -a      → include hidden files
#        ld -l      → detailed view
#        ld -la     → detailed + hidden
ld() {
    local show_hidden=false show_details=false
    for arg in "$@"; do
        case "$arg" in
            -*)
                [[ "$arg" == *a* ]] && show_hidden=true
                [[ "$arg" == *l* ]] && show_details=true
                ;;
        esac
    done

    local dotglob_status=$(shopt -p dotglob)
    local nullglob_status=$(shopt -p nullglob)
    [ "$show_hidden" = true ] && shopt -s dotglob
    shopt -s nullglob

    local dirs=(*/) all_files=(*)
    eval "$dotglob_status"; eval "$nullglob_status"

    local pure_files=()
    for f in "${all_files[@]}"; do [[ ! -d "$f" ]] && pure_files+=("$f"); done
    export __LD_DIRS=("${dirs[@]}")

    [ ${#all_files[@]} -eq 0 ] && { echo "Directory is empty."; return; }

    if [ ${#dirs[@]} -gt 0 ]; then
        if [ "$show_details" = true ] && command -v lsd &>/dev/null; then
            lsd -ld --color=always --icon=always "${dirs[@]}" 2>/dev/null | awk '{printf "\033[1;36m%3d\033[0m %s\n", NR, $0}'
        elif command -v lsd &>/dev/null; then
            lsd -1d --color=always --icon=always "${dirs[@]}" 2>/dev/null | awk '{printf "\033[1;36m%3d\033[0m %s\n", NR, $0}'
        else
            local i=1
            for d in "${dirs[@]}"; do printf "\e[1;36m%3d\e[0m \e[1;34m%s\e[0m\n" "$i" "$d"; ((i++)); done
        fi
    fi

    if [ ${#pure_files[@]} -gt 0 ]; then
        if [ "$show_details" = true ] && command -v lsd &>/dev/null; then
            lsd -ld --color=always --icon=always "${pure_files[@]}" 2>/dev/null | awk '{print "    " $0}'
        elif command -v lsd &>/dev/null; then
            lsd -1d --color=always --icon=always "${pure_files[@]}" 2>/dev/null | awk '{print "    " $0}'
        else
            for f in "${pure_files[@]}"; do printf "    %s\n" "$f"; done
        fi
    fi
}

# cd: Numbered jump (use after ld) + auto-create missing directories
cd() {
    if [[ "$1" =~ ^[0-9]+$ ]] && [[ ! -d "$1" ]]; then
        [ ${#__LD_DIRS[@]} -eq 0 ] && { echo -e "\e[1;31m❌ No directories cached. Run 'ld' first.\e[0m"; return 1; }
        { [ "$1" -gt ${#__LD_DIRS[@]} ] || [ "$1" -lt 1 ]; } && { echo -e "\e[1;31m❌ Invalid number: $1\e[0m"; return 1; }
        builtin cd "${__LD_DIRS[$(( $1 - 1 ))]}" && lsd; return
    fi
    if [ -d "$1" ] || [ -z "$1" ] || [[ "$1" =~ ^- ]]; then
        builtin cd "$@" && lsd
    else
        if [[ $- == *i* ]]; then
            echo -e "\e[1;33m⚠️  Directory '$1' does not exist.\e[0m"
            read -r -p $'\e[1;35m❯ Create it now? [y/N]: \e[0m' answer
            [[ "$answer" =~ ^[Yy]$ ]] && command mkdir -p "$1" && builtin cd "$1" && lsd || return 1
        else
            builtin cd "$@"
        fi
    fi
}

# extract: universal archive extractor
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2) tar xjf "$1" ;; *.tar.gz)  tar xzf "$1" ;; *.tar.xz)  tar xJf "$1" ;;
            *.bz2)     bunzip2 "$1"  ;; *.rar)     unrar x "$1" ;; *.gz)      gunzip "$1"   ;;
            *.tar)     tar xf "$1"   ;; *.tbz2)    tar xjf "$1" ;; *.tgz)     tar xzf "$1"  ;;
            *.zip)     unzip "$1"    ;; *.Z)        uncompress "$1" ;; *.7z) 7z x "$1"       ;;
            *) echo "❌ Don't know how to extract '$1'" ;;
        esac
        echo "✅ Extracted: $1"
    else
        echo "❌ '$1' is not a valid file"
    fi
}

