# Kali-style command-not-found auto-installer
command_not_found_handle() {
    local cmd="$1"
    if [ -x /usr/lib/command-not-found ]; then
        local suggestion; suggestion=$(/usr/lib/command-not-found "$cmd" 2>&1)
        local pkg; pkg=$(echo "$suggestion" | grep -oP 'apt install \K\S+' | head -1)
        if [ -n "$pkg" ]; then
            echo -e "\n\e[1;33m⚠️  Command '\e[1;37m$cmd\e[1;33m' not found.\e[0m"
            echo -e "\e[1;36m📦 Available as package: \e[1;32m$pkg\e[0m\n"
            read -r -p $'\e[1;35m❯ Install now? [y/N]: \e[0m' answer
            if [[ "$answer" =~ ^[Yy]$ ]]; then
                echo ""
                sudo apt-get install -y "$pkg"
            else
                echo -e "\e[1;31m✖ Cancelled.\e[0m"; return 127
            fi
        else
            echo -e "\e[1;31m❌ '$cmd': command not found\e[0m"; return 127
        fi
    else
        echo -e "\e[1;31m❌ '$cmd': command not found\e[0m"; return 127
    fi
}
